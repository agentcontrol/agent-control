# Copy to .env and fill in. .env is gitignored.

# --- the model the chat demo talks to -------------------------------------
#
# Option 1: any OpenAI-compatible endpoint, including a corporate gateway.
# {model} in the URL is substituted, which covers Azure-style deployment paths.
#
# LLM_GATEWAY_URL=https://example.com/openai/deployments/{model}/chat/completions?api-version=...
# LLM_MODEL=
#
# Auth is either a static key:
# LLM_API_KEY=
#
# or OAuth2 client credentials exchanged for a short-lived token:
# LLM_TOKEN_URL=
# LLM_CLIENT_ID=
# LLM_CLIENT_SECRET=
#
# Header carrying the credential. Default "api-key"; use Authorization with a
# "Bearer " prefix for endpoints that expect that.
# LLM_AUTH_HEADER=api-key
# LLM_AUTH_PREFIX=
#
# Extra JSON merged into the request body, for gateways that require their own
# fields such as an application key.
# LLM_EXTRA_BODY={"user": "{\"appkey\": \"...\"}"}

# Option 2: OpenAI directly
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Option 3: Anthropic directly
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# With none of these set, a scripted offline model is used and the guardrail
# flow still works.

# --- where Agent Control is -----------------------------------------------
# AGENT_CONTROL_URL=http://localhost:8000
#
# TYPESAFE_API_KEY is read by the SERVER, not by these demos, because the
# controls run with execution "server". Set it where agent-control-server runs.
