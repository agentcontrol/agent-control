# OpenAI API Key (required for CrewAI)
OPENAI_API_KEY=your-openai-api-key-here

# Serper API Key (required for internet search)
# Get a free key at https://serper.dev/
SERPER_API_KEY=your-serper-api-key-here

# Browserless API Key (optional, for web scraping)
# Get a free key at https://www.browserless.io/
BROWSERLESS_API_KEY=your-browserless-api-key-here

# Agent Control Server URL (optional, defaults to http://localhost:8000)
AGENT_CONTROL_URL=http://localhost:8000
